# Notion integration token (from https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID (from the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)
NOTION_QUOTES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Ninjas key (from https://api-ninjas.com/profile)
API_NINJAS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: quote category (default: wisdom)
# Multiple categories supported, comma-separated: wisdom,success
QUOTE_CATEGORY=wisdom

# Optional: timezone (default: America/New_York)
TIMEZONE=America/New_York
